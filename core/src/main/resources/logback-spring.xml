<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log JSON một dòng mỗi sự kiện, để Loki/Promtail đọc trực tiếp (TS-07.2).
  Mọi dòng có correlationId (từ CorrelationIdFilter) khi xử lý trong yêu cầu HTTP.
  Profile "local" in dạng chữ cho dễ đọc khi chạy trong IDE.
-->
<configuration>
    <springProperty scope="context" name="app" source="spring.application.name" defaultValue="camhub-core"/>

    <springProfile name="local">
        <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!local">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <fieldNames>
                    <timestamp>ts</timestamp>
                    <version>[ignore]</version>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <logger name="AUDIT" level="INFO"/>
</configuration>
