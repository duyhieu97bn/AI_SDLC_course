# Sao chép thành deploy/.env (dev.sh init tự làm). Không đặt mật khẩu ở đây: bí mật nằm trong deploy/secrets/.

# Cổng HTTPS của Nginx trên máy chủ
CAMHUB_HTTPS_PORT=8443

# Địa chỉ trình duyệt dùng để tới cổng WebRTC 8189 của MediaMTX.
# Xem trên chính máy dev: 127.0.0.1. Xem từ máy khác trong LAN: thêm IP LAN của máy chủ, cách nhau bằng dấu phẩy.
CAMHUB_WEBRTC_HOSTS=127.0.0.1

# Profile Spring của Core. "poc" bật endpoint cấp token cho trang đo PoC; bỏ ở staging.
CAMHUB_CORE_PROFILES=dev,poc,demo

# Bộ giả lập RTSP (dev.sh sim): số luồng và codec (h264 | h265)
SIM_STREAMS=24
SIM_CODEC=h264

# Sao lưu (US-40.1) – cú pháp cron, giờ theo CAMHUB_TZ. Mặc định: bản đầy đủ 01:00, differential mỗi giờ, sao chép MinIO phút 30
CAMHUB_TZ=Asia/Ho_Chi_Minh
CAMHUB_BACKUP_FULL_CRON=0 1 * * *
CAMHUB_BACKUP_DIFF_CRON=0 * * * *
CAMHUB_MINIO_MIRROR_CRON=30 * * * *
# Buộc đóng đoạn WAL sau tối đa N giây khi ít ghi (RPO thực tế)
CAMHUB_PG_ARCHIVE_TIMEOUT=300
